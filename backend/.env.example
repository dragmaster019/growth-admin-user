NODE_ENV=development
PORT=4000
DB_URL=mongodb://127.0.0.1:27017/growth
SECRET_KEY=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=replace-with-a-strong-password

# Public URL of the app (used in password reset emails)
APP_URL=http://localhost:4000/app

# Password hashing cost (10-14; production default is 12)
BCRYPT_ROUNDS=12

# Payouts: minimum points per request and cash value of 1 point (INR)
MIN_PAYOUT=500
POINT_VALUE_INR=12

# SMTP (leave blank in development to print reset links to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Growth <no-reply@example.com>
